# Port & App Config
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
JWT_SECRET=replace-with-a-secure-random-jwt-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
DB_PORT=5432
DB_NAME=ifishy
DB_USER=ifishy
DB_PASS=ifishy_secure_password

# Redis Cache & Rate Limiter
REDIS_PORT=6379

# Cloudflare R2 Object Storage (Optional for photo/scan upload)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=ifishy
R2_BUCKET_PRIVATE=
R2_PUBLIC_BASE_URL=https://media.example.com

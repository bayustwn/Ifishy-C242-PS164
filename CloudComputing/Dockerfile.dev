FROM node:18-alpine

# Puppeteer hanya dipakai endpoint scraping opsional — skip download Chromium agar build cepat
ENV PUPPETEER_SKIP_DOWNLOAD=true

# Prisma engine binaries butuh openssl di alpine
RUN apk add --no-cache openssl

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm install

COPY . .
RUN npx prisma generate

EXPOSE 8080

ENTRYPOINT ["npm", "run", "start:stack"]

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid()) @db.Char(36)
  username     String  @unique @db.VarChar(100)
  email        String  @unique @db.VarChar(150)
  password     String  @db.VarChar(255)
  profilePhoto String? @map("profile_photo") @db.VarChar(500)

  posts         Post[]
  comments      Comment[]
  replies       Reply[]
  likes         Like[]
  postVotes     PostVote[]
  shares        Share[]
  bookmarks     Bookmark[]
  scanHistories ScanHistory[]

  @@map("users")
}

model Post {
  id            String   @id @default(uuid()) @db.Char(36)
  userId        String   @map("user_id") @db.Char(36)
  title         String   @db.VarChar(200)
  content       String   @db.Text
  imageUrl      String?  @map("image_url") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  upvoteCount   Int      @default(0) @map("upvote_count")
  downvoteCount Int      @default(0) @map("downvote_count")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  Comment[]
  postVotes PostVote[]
  shares    Share[]

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid()) @db.Char(36)
  postId    String   @map("post_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  content   String   @db.Text
  likeCount Int      @default(0) @map("like_count")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies Reply[]
  likes   Like[]

  @@index([postId])
  @@map("comments")
}

model Reply {
  id              String   @id @default(uuid()) @db.Char(36)
  parentCommentId String   @map("parent_comment_id") @db.Char(36)
  userId          String   @map("user_id") @db.Char(36)
  content         String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  parentComment Comment @relation(fields: [parentCommentId], references: [id], onDelete: Cascade)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parentCommentId])
  @@map("replies")
}

model Like {
  id        String   @id @default(uuid()) @db.Char(36)
  commentId String   @map("comment_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("likes")
}

enum VoteType {
  upvote
  downvote
}

model PostVote {
  id        String   @id @default(uuid()) @db.Char(36)
  postId    String   @map("post_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  voteType  VoteType @map("vote_type")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_votes")
}

model Share {
  id        String   @id @default(uuid()) @db.Char(36)
  postId    String   @map("post_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("shares")
}

model Article {
  id          String    @id @default(uuid()) @db.Char(36)
  title       String    @db.VarChar(300)
  content     String    @db.LongText
  author      String?   @db.VarChar(150)
  publishedAt DateTime? @map("published_at")
  coverImage  String?   @map("cover_image") @db.VarChar(500)

  @@map("articles")
}

enum ItemType {
  post
  article
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  type      ItemType
  itemId    String   @map("item_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, itemId])
  @@map("bookmarks")
}

model ScanHistory {
  id            String   @id @default(uuid()) @db.Char(36)
  userId        String   @map("user_id") @db.Char(36)
  fishImage     String   @map("fish_image") @db.VarChar(500)
  disease       String   @db.VarChar(150)
  confidence    Float
  description   String   @db.VarChar(1000)
  treatment     String   @db.VarChar(1000)
  validation    String?  @db.VarChar(1000)
  scanTimestamp DateTime @map("scan_timestamp")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("scan_history")
}
